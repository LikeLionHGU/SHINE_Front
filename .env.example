# OpenAI Vision API 키. 검사지 사진에서 검사항목/수치/상태를 읽어내는
# lib/ocr.ts(parseTestReport)에서 사용한다. platform.openai.com에서 발급.
# 클라이언트(Expo) 번들에 그대로 포함되므로 EXPO_PUBLIC_ 접두사가 필요하다.
# 주의: 해커톤 데모용 구조라 키가 앱 번들에 노출된다 — 프로덕션에서는
# 반드시 서버를 거쳐 호출해야 한다.
EXPO_PUBLIC_OPENAI_API_KEY=your_openai_api_key_here

# 선택: 요약 생성에 쓸 모델. 비워두면 gpt-4o-mini를 사용한다.
EXPO_PUBLIC_OPENAI_MODEL=

# 선택: 1을 넣으면 AI 요약·추천 질문 생성을 아예 건너뛴다.
# 판정 엔진(lib/labs)이 만든 문장으로 화면이 채워지므로 기능은 그대로 동작한다.
# OpenAI 하루 요청 한도(RPD)에 걸렸거나, 시연 중 실패할 호출을 보내고 싶지 않을 때 켠다.
# 검사지 OCR은 이 값과 무관하게 항상 호출된다.
EXPO_PUBLIC_DISABLE_AI_INSIGHTS=

# 선택: 검사지 사진을 읽는 모델. 비워두면 gpt-4o를 사용한다.
# mini는 수치를 잘못 읽거나 지어내는 경우가 있어 기본값을 gpt-4o로 두었다.
EXPO_PUBLIC_OCR_MODEL=

# 백엔드 주소. 비워두면 src/lib/api 가 목 데이터로 동작한다.
# 값을 넣고 개발 서버를 재시작하면 apiRequest가 이 주소로 요청한다.
# 연결 방법은 src/lib/api/README.md 참고.
EXPO_PUBLIC_API_BASE_URL=https://1.201.117.27.nip.io
